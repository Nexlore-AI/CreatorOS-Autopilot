# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.env.bak*

# ---- Local config and workspace ----
# creatoros.yaml is yours, not the project's; creatoros.example.yaml is the template.
creatoros.yaml
workspace/
out/
logs/
*.jsonl
!examples/**/*.jsonl

# ---- Media: user content, and too big for git ----
*.mp3
*.wav
*.aiff
*.mp4
!examples/specs/*.jpg

# ---- Python ----
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Editor / OS ----
.DS_Store
Thumbs.db
*.bak
*.bak.*
.idea/
.vscode/
.claude/settings.local.json
