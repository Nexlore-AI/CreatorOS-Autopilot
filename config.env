# Nexlore AI content automation settings

# Where finished content is archived (one folder per platform), and the brand kit
CONTENT_DIR="$HOME/Developer/personal/NexloreAI/content"
REELS_DIR="$CONTENT_DIR/instagram/reels"
POSTS_DIR="$CONTENT_DIR/instagram/posts"
FACEBOOK_DIR="$CONTENT_DIR/facebook"
TWITTER_DIR="$CONTENT_DIR/twitter"
YOUTUBE_DIR="$CONTENT_DIR/youtube"
BRAND_DIR="$HOME/Developer/personal/NexloreAI/brand"

# What the daily run does with finished reels:
#   project  = upload into the connected Edit app project as drafts (review before posting)
#   schedule = schedule each reel at POST_TIMES below
#   publish  = post immediately
UPLOAD_MODE=project

# ---- RETIRED: the old reels pipeline's publisher (run_daily.sh + publish_queue.py) ----
# Superseded 2026-11-16. The shorts pipeline below now makes all 4 videos a day and sends
# each to BOTH Instagram and YouTube, because its output is the better-looking one. The
# reels pipeline's launchd job (com.nexloreai.reels) is unloaded, so none of this runs on a
# schedule any more; the code is kept so the day's work can be reproduced if needed.
#
# PUBLISH_MODE stays `draft` on purpose. It is the brake: if anyone runs run_daily.sh or
# publish_queue.py by hand, the reels land in the Zernio dashboard instead of racing the
# shorts pipeline onto Instagram and posting two different videos into the same slot.
#   draft    = uploaded to Zernio, never published
#   schedule = published at the POST_TIMES slot matching the reel's 0N_ prefix (IST)
#   publish  = goes live immediately
PUBLISH_MODE=draft
PUBLISH_PLATFORMS="instagram"
# Visibility of the YouTube Short once it publishes: public | unlisted | private
YT_VISIBILITY=public

# Posting times in IST for slots 1-4 (research, paper, explainer, enterprise). Used by UPLOAD_MODE=schedule.
POST_TIMES="09:00,13:00,18:00,21:00"

# When the daily job starts (24h, local Mac time). Re-run ./setup.sh after changing it.
RUN_HOUR=6
RUN_MINUTE=30

# Safety cap on agent turns per run
MAX_TURNS=150

# ---- Voiceover ----
# elevenlabs = most natural. The API key lives in .env (written by the ElevenLabs onboarding), never here.
#              If no key is found, reels fall back to the macOS voices below.
# say / openai / none are also supported.
TTS_BACKEND=elevenlabs
# Female voice that speaks Hindi + English. "auto" = pick_voice.py chooses one on the next render and writes its ID here.
# Chosen voice: Tisha K - E-Learning Professor (Hindi female, 158.8 wpm - the fastest of the three auditioned)
ELEVENLABS_VOICE_ID=wmIQDUiVl74MwMw9Rpag
ELEVENLABS_MODEL=eleven_multilingual_v2
# Which reel slots are narrated in Hinglish: comma list of research, paper, explainer, enterprise (or "all")
HINGLISH_SLOTS="all"
# macOS fallback voices. MUST speak Devanagari: Samantha and Rishi silently skip it
# (measured 2026-11-07: +0.60s vs +3.05s for the same Hindi clause).
SAY_VOICE="Tara"
SAY_VOICE_HINGLISH="Lekha"
SAY_RATE=185
OPENAI_TTS_VOICE=alloy

# ---- Publishing (Zernio) ----
# Which backend the upload step uses:
#   metapilot = the local Edit app project via the metapilot-native MCP server (unchanged default)
#   zernio    = Zernio REST API, which fans out to the connected social accounts (./zernio)
UPLOAD_BACKEND=metapilot
# Limit which connected platforms a reel goes to: comma list, e.g. "instagram,youtube". Empty = all active.
ZERNIO_PLATFORMS=
# Only if your Zernio workspace uses profiles; otherwise leave empty.
ZERNIO_PROFILE_ID=
# Timezone that POST_TIMES is expressed in when scheduling through Zernio.
POST_TZ=Asia/Kolkata
# The Zernio API key is a secret: it lives in .env as ZERNIO_API_KEY, never in this file.

# ---- The content pipeline (shorts/run_shorts.sh, installed by shorts/setup_shorts.sh) ----
# This is now the ONLY pipeline. It makes 4 videos a day in the v3 house style
# (shorts/STYLE.md) and publishes each one to BOTH Instagram and YouTube via Zernio.
# The old reels pipeline (run_daily.sh) is retired -- see the PUBLISH_MODE note above.
SHORTS_PER_DAY=4
SHORTS_POST_TIMES="09:00,13:00,18:00,21:00"   # IST, one per video, matched to the 0N_ prefix
SHORTS_PLATFORMS="instagram,youtube"     # both platforms get the same MP4 at the same slot
SHORTS_RUN_HOUR=6                        # when the daily job starts (local Mac time)
SHORTS_RUN_MINUTE=30
SHORTS_PUBLISH_MODE=auto                 # auto = public at the slot times · draft = Zernio drafts only
# Videos render today and publish on a LATER day's slots. Rendering 4 takes ~6 h (measured:
# 3 h 11 m for 2 on 2026-11-16), so a same-day 09:00 slot was unreachable -- the run would
# finish past it and slot 1 would fire late, bunched against slot 2. With an offset of 1 the
# render never races the clock and every slot lands on time, at the cost of a day of lag.
# Set 0 for same-day publishing (slots already passed publish immediately instead).
SHORTS_PUBLISH_OFFSET_DAYS=1
SHORTS_VOICE_ID=ZI6I4a3UGgs1DXxqWjBV     # Riya Rao (Hindi). Auditioned: Jia ItmwhOeluca31IEX91Yk · Devi MF4J4IDTRo0AxOO4dpFR · Anika FiIgWdzVKAalJyAgg8Pg · Tisha K wmIQDUiVl74MwMw9Rpag
SHORTS_MUSIC_MODE=library                # library = rotate shorts/music/*.mp3 · generate = new ElevenLabs track per Short (more credits)
SHORTS_MAX_TURNS=240                     # 4 videos a run now, so double the old cap
