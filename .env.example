# Copy to .env and fill in only the services you use. .env is gitignored and is the ONLY
# place secrets belong — creatoros.yaml holds settings and never keys.
#
# Nothing here is required to render. `creatoros render examples/specs/kv-cache.json`
# works with this file empty.

# ---- Narration (tts.backend in creatoros.yaml picks one) ----
ELEVENLABS_API_KEY=

# ---- Publishing ----
# Zernio fans one post out to connected accounts. Direct YouTube Data API and Instagram
# Graph API publishers arrive in Phase 2 and become the documented default.
ZERNIO_API_KEY=
