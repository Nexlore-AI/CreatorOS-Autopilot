#!/bin/bash
# Shorts helper: uses the automation .venv and keys.
#   shorts/short audio   SPEC.json    voice clips (ElevenLabs) + music choice
#   shorts/short preview SPEC.json    contact sheet SPEC.preview.jpg
#   shorts/short render  SPEC.json    SPEC.mp4 (+ .cover.jpg)
set -euo pipefail
A="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
set -a; source "$A/config.env"; [[ -f "$A/.env" ]] && source "$A/.env"; [[ -f "$A/.env.local" ]] && source "$A/.env.local"; set +a
PY=python3; [[ -x "$A/.venv/bin/python" ]] && PY="$A/.venv/bin/python"
cmd="${1:-}"; shift || true
case "$cmd" in
  audio)   exec "$PY" "$A/shorts/make_audio.py" "$@" ;;
  preview) exec "$PY" "$A/engine/shorts_engine.py" preview "$@" ;;
  render)  exec "$PY" "$A/engine/shorts_engine.py" render "$@" ;;
  *) echo "usage: shorts/short audio|preview|render SPEC.json"; exit 2 ;;
esac
